{
  "name": "@local/squad-dashboard",
  "version": "0.7.3",
  "private": true,
  "description": "Read-only squad dashboard: discovers squad sessions across workspaces and shows members, activity and agent-team tasks in a sidebar panel.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
