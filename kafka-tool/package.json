{
  "name": "@local/kafka-tool",
  "version": "1.2.0",
  "private": true,
  "description": "Kafka Tool-style sidebar panel: browse topics and consumer group lag, subscribe to multi-topic message streams with manual and polling refresh.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "build",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "node build/client.mjs",
    "pretest": "node build/client.mjs --check",
    "test": "node --test test/*.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "kafkajs": "^2.2.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "devDependencies": {
    "@guozhi5658/srp-table": "1.1.6",
    "esbuild": "0.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "4.24.1"
  }
}
