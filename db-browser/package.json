{
  "name": "@local/db-browser",
  "version": "1.2.0",
  "private": true,
  "description": "DBeaver-style database browser sidebar panel with agent tools (MySQL/TDSQL-MySQL/GoldenDB, PostgreSQL/TDSQL-PG, Oracle, Redis), pooled connections and a per-vendor feature matrix.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "build",
    "mcp-server.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node build/client.mjs",
    "pretest": "node build/client.mjs --check",
    "test": "node --test test/*.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "ioredis": "^5.4.2",
    "mysql2": "^3.11.5",
    "oracledb": "^6.7.0",
    "pg": "^8.23.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "bin": {
    "db-browser-mcp": "./mcp-server.js"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-resizable-panels": "4.24.1"
  }
}
